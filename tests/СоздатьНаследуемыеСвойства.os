Перем Ф, ИОС, СтрКласса, КаталогСправки;
Перем ПолеВыбора4, Кнопка1, Флажок1;

Процедура Кн_Нажатие() Экспорт
	Кнопка1.Доступность = Ложь;
	Если Флажок1.Помечен = Истина Тогда
		Для А = 0 По ПолеВыбора4.Элементы.Количество - 1 Цикл
			ПолеВыбора4.ИндексВыбранного = А;
			// Сообщить("ПолеВыбора4.Текст = " + ПолеВыбора4.Текст);
			ПолеВыбора4.Обновить();
			Приостановить(1000);
			Ф.ПередатьУправление();
			
			СтрКласса = СокрЛП(ПолеВыбора4.Текст);
			Если СтрКласса = "" Тогда
				Ф.ОкноСообщений().Показать("Не выбран класс - наследник.", "Выбор класса");
				Возврат;
			КонецЕсли;
			СтрКласса = СтрЗаменить(СтрКласса, " ", " (");
			СтрКласса = СтрКласса + ") Класс";
			СоздатьНаследуемыеСвойства();
		КонецЦикла;
		Ф.ОкноСообщений().Показать("Все классы обработаны!", "Завершено");
	Иначе
		СтрКласса = СокрЛП(ПолеВыбора4.Текст);
		Если СтрКласса = "" Тогда
			Ф.ОкноСообщений().Показать("Не выбран класс - наследник.", "Выбор класса");
			Возврат;
		КонецЕсли;
		СтрКласса = СтрЗаменить(СтрКласса, " ", " (");
		СтрКласса = СтрКласса + ") Класс";
		СоздатьНаследуемыеСвойства();
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПолеВыбора4()
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать("C:\444\OneScriptGameForms\docs\doc.html");
	Стр = ТекстДок.ПолучитьТекст();
	М = ИОС.СтрНайтиМежду(Стр, 
			"menu3", 
			"</summary>", 
			, );
	Если М.Количество() > 0 Тогда
		// Сообщить("М[0] = " + М[0]);
		Для А = 0 По М.ВГраница() Цикл
			М2 = ИОС.СтрНайтиМежду(М[А], "right"">", "</a>", , );
			Если М2.Количество() > 0 Тогда
				// Сообщить("М2[0] = " + М2[0]);
				Для А2 = 0 По М2.ВГраница() Цикл
					СтрКласс = М2[0];
					СтрКласс = СтрЗаменить(СтрКласс, "(", "");
					СтрКласс = СтрЗаменить(СтрКласс, ")", "");
					
					Если СтрКласс <> "Цвет Color" 
						и СтрКласс <> "Строка String" 
					Тогда
						ПолеВыбора4.Элементы.Добавить(СтрКласс);
						// Сообщить("" + М2[0]);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПостроитьСписокРодителей(ПутьФайлHTMLКласса)
	СписокРодителей = Новый СписокЗначений();
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ПутьФайлHTMLКласса);
	Стр = ТекстДок.ПолучитьТекст();
	// <h4 class=dtH4>Иерархия</h4>
	// <h4 class=dtH4>Смотрите также</h4>
	Иерархия1 = ИОС.СтрНайтиМежду(Стр, "<h4 class=dtH4>Иерархия</h4>", "<h4 class=dtH4>Смотрите также</h4>", , )[0];
	Наследник = ИОС.СтрНайтиМежду(Иерархия1, "<b>", "</b>", , )[0]; // <b>Кнопка (Button)</b>
	Родители = ИОС.СтрНайтиМежду(Иерархия1, "<p>", "<b>", , );
	СписокРодителей = Новый СписокЗначений();
	Если Родители.Количество() > 0 Тогда
		Для А = 0 По Родители.ВГраница() Цикл
			СтрокиРодителя = ИОС.СтрНайтиМежду(Родители[А], "<a", "</a>", );
			Если СтрокиРодителя.Количество() > 0 Тогда
				Для А1 = 0 По СтрокиРодителя.ВГраница() Цикл
					СтрокаРодителя = СтрокиРодителя[А1];
					// Сообщить("СтрокаРодителя = " + СтрокаРодителя);
					Путь = ИОС.СтрНайтиМежду(СтрокаРодителя, "=""", """>")[0];
					Путь = ОбъединитьПути(КаталогСправки, Путь);
					Представление = ИОС.СтрНайтиМежду(СтрокаРодителя, """>", ")")[0] + ")";
					СписокРодителей.Добавить(Путь, Представление);
					// Сообщить("1= " + Путь);
					// Сообщить("2= " + Представление);
					// Сообщить("=====================================");
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокРодителей;
КонецФункции//ПостроитьСписокРодителей

Функция ПостроитьСписокСвойствИзСправки(ПутьФайлHTMLСвойств)
	СписокСвойствИзСправки = Новый СписокЗначений();
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ПутьФайлHTMLСвойств);
	Стр = ТекстДок.ПолучитьТекст();
	//Находим текст таблицы.
	М = ИОС.СтрНайтиМежду(Стр, "<tr vAlign=top>", "</tr>", , );
	Если М.Количество() > 0 Тогда
		Для А = 0 По М.ВГраница() Цикл
			// Проверим существует ли файл свойства.
			ПолныйПуть = ИОС.СтрНайтиМежду(М[А], "<a href=""", """>", , )[0];
			ПолныйПуть = ОбъединитьПути(КаталогСправки, ПолныйПуть);
			ФайлСвойства = Новый Файл(ПолныйПуть);
			Если Не ФайлСвойства.Существует() Тогда
				Сообщить("Не найден файл свойства " + ПолныйПуть);
				Продолжить;
			КонецЕсли;
			СвойствоРус = ИОС.СтрНайтиМежду(М[А], "Property.html"">", "&nbsp;(", , )[0];
			СвойствоАнгл = ИОС.СтрНайтиМежду(М[А], "(", ")", , )[0];
			СвойствИзСправки = СвойствоРус + " (" + СвойствоАнгл + ")";
			Унаследовано = СокрЛП(ИОС.СтрНайтиМежду(М[А], "</a>", "</td>", , )[0]);
			СписокСвойствИзСправки.Добавить(СвойствИзСправки, Унаследовано);
			// Сообщить("СвойствИзСправки = " + СвойствИзСправки);
			// Сообщить("Унаследовано = " + Унаследовано);
			// Сообщить("=================================================");
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокСвойствИзСправки;
КонецФункции//ПостроитьСписокСвойствИзСправки

Процедура СоздатьУнаследованноеСвойство(ПутьДоСвойстваРодителя, СвойствоРодителя, ТекущийРодитель, Наследник)
	// Сообщить("=== ПутьДоСвойстваРодителя " + ПутьДоСвойстваРодителя);

	СвойствоРус = СтрРазделить(СвойствоРодителя, " ")[0];
	СвойствоАнгл = СтрРазделить(СвойствоРодителя, " ")[1];
	СвойствоАнгл = СтрЗаменить(СвойствоАнгл, "(", "");
	СвойствоАнгл = СтрЗаменить(СвойствоАнгл, ")", "");
    // Сообщить("СвойствоРус = " + СвойствоРус);
    // Сообщить("СвойствоАнгл = " + СвойствоАнгл);
	КлассРодителяРус = СтрРазделить(ТекущийРодитель, " ")[0];
	КлассРодителяАнгл = СтрРазделить(ТекущийРодитель, " ")[1];
	КлассРодителяАнгл = СтрЗаменить(КлассРодителяАнгл, "(", "");
	КлассРодителяАнгл = СтрЗаменить(КлассРодителяАнгл, ")", "");
    // Сообщить("КлассРодителяРус = " + КлассРодителяРус);
    // Сообщить("КлассРодителяАнгл = " + КлассРодителяАнгл);
	
	ТекстДок = Новый ТекстовыйДокумент;
	ФайлСвойство = "C:\444\OneScriptGameForms\docs\OSGForms\OSGForms." + КлассРодителяАнгл + СвойствоАнгл + "Property.html";
	КаталогНаДиске = Новый Файл(ФайлСвойство);
    Если Не (КаталогНаДиске.Существует()) Тогда
		Возврат;
	КонецЕсли;
	ТекстДок.Прочитать(ФайлСвойство);
	СтрТекстДок = ТекстДок.ПолучитьТекст();
	// Сообщить("СтрТекстДок = " + СтрТекстДок);
	М = ИОС.СтрНайтиМежду(СтрТекстДок, "Использование</h4>", "/p>", , );
	Использование = ИОС.СтрНайтиМежду(М[0], "<p>", "<", , )[0]; // ПолеВыбора1
	
	ЗначениеОписание = "";
	ЗначениеТип = "";
	М = ИОС.СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Значение</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	Если М.Количество() > 0 Тогда
		// Сообщить("" + М2[1]);
		М2 = ИОС.СтрНайтиМежду(М[0], "<p>", "</p>", , );
		Если М2.Количество() > 0 Тогда
			Попытка
				ЗначениеТип = М2[0]; // ПолеВыбора2
				ЗначениеТип = СтрЗаменить(ЗначениеТип, "Тип:", " ");
				ЗначениеТип = СтрЗаменить(ЗначениеТип, " ", "");
				ЗначениеТип = СтрЗаменить(ЗначениеТип, "ahref", "a href");
				// Сообщить("ЗначениеТип = " + ЗначениеТип);
			Исключение
			КонецПопытки;
			Попытка
				ЗначениеОписание = М2[1]; // ПолеВвода5
				// Сообщить("ЗначениеОписание = " + ЗначениеОписание);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Текст_Класс = Наследник; // Класс
	Текст_СвойствоИмяРус = СвойствоРус; // СвойствоИмяРус
	Текст_СвойствоИмяEn = СвойствоАнгл; // СвойствоИмяEn
	Текст_ЗначениеОписание = ЗначениеОписание; // ЗначениеОписание
	Текст_Использование = Использование; // Использование
	Текст_ЗначениеТип = ЗначениеТип; // ЗначениеТип
	// Сообщить("Текст_Класс = " + Текст_Класс);
	// Сообщить("Текст_СвойствоИмяРус = " + Текст_СвойствоИмяРус);
	// Сообщить("Текст_СвойствоИмяEn = " + Текст_СвойствоИмяEn);
	// Сообщить("Текст_Использование = " + Текст_Использование);
	// Сообщить("Текст_ЗначениеТип = " + Текст_ЗначениеТип);
	// Сообщить("Текст_ЗначениеОписание = " + Текст_ЗначениеОписание);
	// Сообщить("==========================================");
	
	ИсходныйФайл = "C:\444\OneScriptGameForms\ФабрикаHtml\СозданиеСвойства.os";
	КопияФайла = "C:\444\OneScriptGameForms\ФабрикаHtml\СозданиеСвойстваШаблон.os";
	КопироватьФайл(ИсходныйФайл, КопияФайла);
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(КопияФайла);
	Стр = ТекстДок.ПолучитьТекст();
	
	ПодстрокаПоиска = 
	"Процедура НачальноеЗаполнениеФормы()
	|	ПолеВыбора3.Текст = """"; // Класс
	|	ПолеВвода3.Текст = """"; // СвойствоИмяРус
	|	ПолеВвода4.Текст = """"; // СвойствоИмяEn
	|	ПолеВвода5.Текст = """"; // ЗначениеОписание
	|	ПолеВыбора1.Текст = """"; // Использование
	|	ПолеВыбора2.Текст = """"; // ЗначениеТип
	|	ПолеВыбора4.Текст = """";
	|	
	|	ЗаполнитьПолеВыбора3();
	|	ЗаполнитьПолеВыбора6();
	|	Флажок1.Помечен = Ложь;
	|КонецПроцедуры";
	ПодстрокаЗамены = 
	"Процедура НачальноеЗаполнениеФормы()
	|	ПолеВыбора3.Текст = """ + Текст_Класс + """; // Класс
	|	ПолеВвода3.Текст = """ + Текст_СвойствоИмяРус + """; // СвойствоИмяРус
	|	ПолеВвода4.Текст = """ + Текст_СвойствоИмяEn + """; // СвойствоИмяEn
	|	ПолеВвода5.Текст = """ + Текст_ЗначениеОписание + """; // ЗначениеОписание
	|	ПолеВыбора1.Текст = """ + Текст_Использование + """; // Использование
	|	ПолеВыбора2.Текст = """ + СтрЗаменить(Текст_ЗначениеТип, """", """""") + """; // ЗначениеТип
	|	ПолеВыбора4.Текст = """ + КлассРодителяРус + " " + КлассРодителяАнгл + """; // унаследовано от
	|	
	|	ЗаполнитьПолеВыбора3();
	|	ЗаполнитьПолеВыбора6();
	|	Флажок1.Помечен = Ложь;
	|	
	|	Ф.ПередатьУправление();
	|	Приостановить(1000);
	|	Кн_Нажатие();
	|КонецПроцедуры";
	Стр = СтрЗаменить(Стр, ПодстрокаПоиска, ПодстрокаЗамены);
	
	ПодстрокаПоиска = 
	"ОкноСообщений1 = Ф.ОкноСообщений();
	|	Если Флажок1.Помечен Тогда
	|		КопироватьФайл(ОткудаПереносим1, КудаПереносим1);
	|		Приостановить(500);
	|		КопироватьФайл(ОткудаПереносим2, КудаПереносим2);
	|		Приостановить(500);
	|		УдалитьФайлы(ВыходнойКаталог, ""*.html"");  
	|		Ф.Предупреждение(""Завершено "" + КлассИмяРус + ""."" + СвойствоИмяРус, 1, ""Завершено"");
	|	Иначе
	|		Ф.ОкноСообщений().Показать(""Завершено"", ""Завершено"");
	|	КонецЕсли;";
	ПодстрокаЗамены = 
	"//ОкноСообщений1 = Ф.ОкноСообщений();
	|//	Если Флажок1.Помечен Тогда
	|//		КопироватьФайл(ОткудаПереносим1, КудаПереносим1);
	|//		Приостановить(500);
	|//		КопироватьФайл(ОткудаПереносим2, КудаПереносим2);
	|//		Приостановить(500);
	|//		УдалитьФайлы(ВыходнойКаталог, ""*.html"");  
	|//		Ф.Предупреждение(""Завершено "" + КлассИмяРус + ""."" + СвойствоИмяРус, 1, ""Завершено"");
	|//	Иначе
	|//		Ф.ОкноСообщений().Показать(""Завершено"", ""Завершено"");
	|//	КонецЕсли;
	|
	|	Приостановить(1000);
	|
	|	ЗавершитьРаботу(0);";
	Стр = СтрЗаменить(Стр, ПодстрокаПоиска, ПодстрокаЗамены);
	
	ТекстДок.УстановитьТекст(Стр);
	ТекстДок.Записать(КопияФайла);
	Приостановить(1000);
	// Теперь нужно запустить КопияФайла.
	Команда1("""C:\Program Files\OneScript\bin\oscript.exe""", КопияФайла);
	
	// Теперь нужно переместить с заменой файлы из "C:\444\OneScriptGameForms\НовыеHtml" в 
	// "C:\444\OneScriptGameForms\docs\OSGForms".
	Файлы = НайтиФайлы("C:\444\OneScriptGameForms\НовыеHtml", "*.html", Ложь);
	Для А1 = 0 По Файлы.ВГраница() Цикл
		// Сообщить("" + Файлы[А1].Имя);
		Попытка
			УдалитьФайлы("C:\444\OneScriptGameForms\docs\OSGForms\" + Файлы[А1].Имя);
		Исключение
		КонецПопытки;
		ПереместитьФайл(Файлы[А1].ПолноеИмя, ОбъединитьПути("C:\444\OneScriptGameForms\docs\OSGForms", Файлы[А1].Имя));
	КонецЦикла;
КонецПроцедуры//СоздатьУнаследованноеСвойство

Процедура СоздатьНаследуемыеСвойства()
	СтрКлассаEn = ИОС.СтрНайтиМежду(СтрКласса, "(", ")", , )[0];
	ПутьФайлHTMLКласса = ОбъединитьПути(КаталогСправки, "OSGForms." + СтрКлассаEn + ".html");
	// Сообщить("ПутьФайлHTMLКласса = " + ПутьФайлHTMLКласса);
	
	// Строим цепочку наследования до самого верхнего родителя.
	СписокРодителей = ПостроитьСписокРодителей(ПутьФайлHTMLКласса);
	
	// Заполним список уже занесенных в справку свойств наследника.
	// C:\444\OneScriptGameForms\docs\OSGForms\OSGForms.ButtonProperties.html
	ПутьФайлHTMLСвойств = ОбъединитьПути(КаталогСправки, "OSGForms." + СтрКлассаEn + "Properties.html");
	СписокСвойствНаследникаИзСправки = ПостроитьСписокСвойствИзСправки(ПутьФайлHTMLСвойств);
	
	// Перебираем родителей, получаем их свойства, только те, которые не унаследованы.
	// Если в СписокСвойствНаследникаИзСправки не находим такого свойства, то создаем его в справке.
	Для А = 0 По СписокРодителей.Количество() - 1 Цикл
		ПутьФайлHTMLСвойствРодителя = СписокРодителей.Получить(А).Значение;
		ПутьФайлHTMLСвойствРодителя = СтрЗаменить(ПутьФайлHTMLСвойствРодителя, ".html", "Properties.html");
		// Сообщить("ПутьФайлHTMLСвойствРодителя === " + ПутьФайлHTMLСвойствРодителя);
		ТекущийРодитель = СписокРодителей.Получить(А).Представление;
		// Сообщить("=== " + ТекущийРодитель + " ===");
		СписокСвойствРодителяИзСправки = ПостроитьСписокСвойствИзСправки(ПутьФайлHTMLСвойствРодителя);
		Для А1 = 0 По СписокСвойствРодителяИзСправки.Количество() - 1 Цикл
			Представление = СписокСвойствРодителяИзСправки.Получить(А1).Представление;
			Если Не СтрНайти(Представление, "(унаследовано от") > 0 Тогда
				СвойствоРодителя = СписокСвойствРодителяИзСправки.Получить(А1).Значение;
				// Сообщить("=== Значение = " + СвойствоРодителя);
				// Сообщить("=== Представление =" + СписокСвойствРодителяИзСправки.Получить(А1).Представление);
				// Проверим наличие свойства в справке. Если не найдем, то создадим в справке.
				Если СписокСвойствНаследникаИзСправки.НайтиПоЗначению(СвойствоРодителя) = Неопределено Тогда
					// Создадим в справке.
					Сообщить("=== Создаем свойство " + СвойствоРодителя + " Унаследовано от " + ТекущийРодитель);
					// ПутьФайлHTMLСвойствРодителя === C:\444\OneScriptGameForms\docs\OSGForms\OSGForms.GObjectProperties.html
					// === ОбъектГодо (GObject) ===
					// === Значение = КлючЭлемента (ItemKey)
					// === Создаем свойство КлючЭлемента (ItemKey) Унаследовано от ОбъектГодо (GObject)
					// === Значение = Метка (Tag)
					// === Создаем свойство Метка (Tag) Унаследовано от ОбъектГодо (GObject)
					
					// file:///C:/444/OneScriptGameForms/docs/OSGForms/OSGForms.GObjectItemKeyProperty.html
					СвойствоИмяEn = ИОС.СтрНайтиМежду(СвойствоРодителя, "(", ")", , )[0];
					ПутьДоСвойстваРодителя = СтрЗаменить(ПутьФайлHTMLСвойствРодителя, "Properties.html", "." + СвойствоИмяEn + "Property.html");
					Наследник = СтрЗаменить(СтрКласса, " Класс", "");
					Наследник = СтрЗаменить(Наследник, "(", "");
					Наследник = СтрЗаменить(Наследник, ")", "");
					СоздатьУнаследованноеСвойство(ПутьДоСвойстваРодителя, СвойствоРодителя, ТекущийРодитель, Наследник);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// // // Ф.ОкноСообщений().Показать("Завершено", "Завершено");
КонецПроцедуры//СоздатьНаследуемыеСвойства

Функция Команда1(ИмяФайла, Аргументы)
	Процесс1 = СоздатьПроцесс(ИмяФайла + " " + Аргументы,,,);
	Процесс1.Запустить();
	Ф.ПередатьУправление();
	Процесс1.ОжидатьЗавершения();
КонецФункции//Команда1

Процедура Флажок1_ПометкаИзменена() Экспорт
