Процедура ЗапускКодов()
	ВыбранныеФайлы = НайтиФайлы(КаталогСправки, "*.html", Истина);
	Для А = НачальныйНомерФайла По ВыбранныеФайлы.ВГраница() Цикл //ВыбранныеФайлы.ВГраница()
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ВыбранныеФайлы[А].ПолноеИмя);
		Стр = ТекстДок.ПолучитьТекст();

		Заголовок = "";
		М0 = ИОС.СтрНайтиМежду(Стр, "<h1 class=dtH1>", "</h1>", , );
		Если М0.Количество() > 0 Тогда
			Заголовок = СтрЗаменить(М0.Получить(0), "&nbsp;", " ");
		КонецЕсли;
		
		М = ИОС.СтрНайтиМежду(Стр, "<summary>Полный пример кода</summary>", "</pre>", Ложь, );
		Если М.Количество() > 0 Тогда
			СтрСообщения = "(" + ИОС.Математика().Окр(((ТекущаяУниверсальнаяДатаВМиллисекундах() - Таймер)/1000)/60, 2) + " мин." + " " + А + " из " + 
			ВыбранныеФайлы.ВГраница() + ") " + ВыбранныеФайлы[А].ПолноеИмя + " /" + Заголовок;
			
			Для А2 = 0 По М.ВГраница() Цикл
				ТестовыйКод = ИОС.СтрНайтиМежду(М.Получить(А2), "<div id=""", "</div>", Ложь, ).Получить(0);
				ТестовыйКод = ИОС.СтрНайтиМежду(ТестовыйКод, """>", "</div>", , ).Получить(0);
				
				Если Не (СокрЛП(ТестовыйКод) = "") Тогда
					ИмяИзЗаголовка = ИОС.СтрНайтиМежду(Заголовок, , " ")[0];
					ИмяИзЗаголовка = СтрЗаменить(ИмяИзЗаголовка, ".", "_") + ".os";
					ТестируемыйФайл = ОбъединитьПути(КаталогTemp, ИмяИзЗаголовка);
					
					ИОС.ЗаписатьВесьТекст(ТестируемыйФайл, ТестовыйКод);
					Пока Не Новый Файл(ТестируемыйФайл).Существует() Цикл
						Приостановить(100);
					КонецЦикла;
					
					Если Вин Тогда
						Пока КоличествоЗаданий.Количество() > 10 Цикл 
							Приостановить(500);
						КонецЦикла;
					Иначе
						Пока КоличествоЗаданий.Количество() > 4 Цикл 
							Приостановить(500);
						КонецЦикла;
					КонецЕсли;
					
					Всего = Всего + 1;

					Если Вин Тогда
						Попытка
							ИмяФайлаOscript = ОбъединитьПути("C:\444-спутник\OneScript-2.0.0-win-x64\bin", "oscript.exe");
							РабочийКаталог = ИОС.КаталогСценария(ЭтотОбъект);
							МассивПараметров = Новый Массив(4);
							МассивПараметров[0] = ТестируемыйФайл; // Тестируемый файл.
							МассивПараметров[1] = ИмяФайлаOscript;
							МассивПараметров[2] = РабочийКаталог;
							МассивПараметров[3] = СтрСообщения;
							Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапуститьКоманду", МассивПараметров);
							
							БлокировкаРесурса1.Заблокировать();
							КоличествоЗаданий.Добавить(СтрСообщения);
							БлокировкаРесурса1.Разблокировать();
						Исключение
							Сообщить("Ошибка ФоновыеЗадания.Выполнить: " + ТестируемыйФайл);
						КонецПопытки;
					Иначе
						Попытка
							МассивПараметров = Новый Массив(2);
							МассивПараметров[0] = ТестируемыйФайл;
							МассивПараметров[1] = СтрСообщения;
							Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапуститьТестАвто", МассивПараметров);
							
							БлокировкаРесурса1.Заблокировать();
							КоличествоЗаданий.Добавить(СтрСообщения);
							БлокировкаРесурса1.Разблокировать();
						Исключение
							Сообщить("Ошибка ФоновыеЗадания.Выполнить: " + ТестируемыйФайл);
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры//ЗапускКодов

Процедура ЗапуститьТестАвто(ТестируемыйФайл, СтрСообщения) Экспорт
    СтрокаКоманды = "oscript"+ " " + ТестируемыйФайл;

    ДождатьсяЗавершения = Истина;
    КодВозврата = 1;
	Попытка
		ЗапуститьПриложение(СтрокаКоманды, , ДождатьсяЗавершения, КодВозврата);
		Сообщить("КодВозврата = " + КодВозврата + " - " + СтрСообщения);
		
		Если Не КодВозврата = 0 Тогда
			Сбойных = Сбойных + 1;
		КонецЕсли;

		БлокировкаРесурса1.Заблокировать();
		Номер = КоличествоЗаданий.Найти(СтрСообщения);
		Если Не Номер = Неопределено Тогда
			КоличествоЗаданий.Удалить(Номер);
		КонецЕсли;
		БлокировкаРесурса1.Разблокировать();
	Исключение
		Сообщить("Ошибка ЗапуститьТестАвто для: " + СтрСообщения);
	КонецПопытки;
КонецПроцедуры

Процедура ЗапуститьКоманду(ТестируемыйФайл, ИмяФайлаOscript, ТекущийКаталог, СтрСообщения) Экспорт
	ЛогФайл = ИОС.СтрНайтиМежду(СтрСообщения, "/", " (")[0];
	ЛогФайл = СтрЗаменить(ЛогФайл, ".", "_") + ".log";
	
	ЛогФайл = ОбъединитьПути(КаталогTemp, ЛогФайл);
	ИОС.ДобавитьВесьТекст(ЛогФайл, СтрСообщения + Символы.ПС);
	Пока Не ИОС.ОжидатьФайл(ЛогФайл) Цикл
		Приостановить(100);
	КонецЦикла;

	СтрокаКоманды = СтрШаблон("cmd.exe /c " + ИмяФайлаOscript + " ""%1"" >> ""%2""", ТестируемыйФайл, ЛогФайл); // !!! Рабочий вариант.
	
	ДождатьсяЗавершения = Истина;
	КодВозврата = 1;
	ТекущийПример = СтрСообщения;
	Попытка
		ЗапуститьПриложение(СтрокаКоманды, ТекущийКаталог, ДождатьсяЗавершения, КодВозврата);
		
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ЛогФайл);
		СтрДок = ТекстДок.ПолучитьТекст();
		
		Если (СтрНайти(СтрДок, "{Модуль") > 0) или (СтрНайти(СтрДок, "Error") > 0) Тогда
			КодВозврата = 1;
		КонецЕсли;
		Сообщить("КодВозврата = " + КодВозврата + " - " + ТекущийПример);
		
		Если Не КодВозврата = 0 Тогда
			Сбойных = Сбойных + 1;
		КонецЕсли;
		
		БлокировкаРесурса1.Заблокировать();
		Номер = КоличествоЗаданий.Найти(СтрСообщения);
		Если Не Номер = Неопределено Тогда
			КоличествоЗаданий.Удалить(Номер);
		КонецЕсли;
		БлокировкаРесурса1.Разблокировать();
	Исключение
		Сообщить("Ошибка ЗапуститьПриложение: " + ТестируемыйФайл);
	КонецПопытки;
КонецПроцедуры

Таймер = ТекущаяУниверсальнаяДатаВМиллисекундах();

// Все пути, необходимые для тестирования будем вычислять из пути к сценарию.
ПутьСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
КаталогTemp = ОбъединитьПути(ПутьСценария, "Temp");
Если Не Новый Файл(КаталогTemp).Существует() Тогда
	СоздатьКаталог(КаталогTemp);
КонецЕсли;
Счетчик = 0;
Пока Не Новый Файл(КаталогTemp).Существует() или Счетчик < 50 Цикл
	Приостановить(100);
	Счетчик = Счетчик + 1;
КонецЦикла;
Если Не Новый Файл(КаталогTemp).Существует() Тогда
	Сообщить("Не удалось создать каталог КаталогTemp.");
	ЗавершитьРаботу(1);
КонецЕсли;

УдалитьФайлы(КаталогTemp, "*.*");

ПутьИнтегратора = ОбъединитьПути(КаталогTemp, "OneScriptIntegrator.dll");
ЗаписатьИнтегратор(ПутьИнтегратора);
Счетчик = 0;
Пока Не Новый Файл(ПутьИнтегратора).Существует() или Счетчик < 50 Цикл
	Приостановить(100);
	Счетчик = Счетчик + 1;
КонецЦикла;
Если Не Новый Файл(ПутьИнтегратора).Существует() Тогда
	Сообщить("Не удалось создать каталог ПутьИнтегратора.");
	ЗавершитьРаботу(1);
КонецЕсли;
ПодключитьВнешнююКомпоненту(ОбъединитьПути(КаталогTemp, "OneScriptIntegrator.dll"));
ИОС = Новый ИнтеграторОдноСкрипта();

Вин = Ложь;
Если СтрНайти((Новый СистемнаяИнформация()).ВерсияОС, "Windows") > 0 Тогда
	Вин = Истина;
КонецЕсли;

Если Вин Тогда
	КаталогСправки = ОбъединитьПути(ИОС.РодительскийКаталог(ИОС.РодительскийКаталог(ПутьСценария)), "docs\OSGForms");
Иначе
	КаталогСправки = ОбъединитьПути(ИОС.РодительскийКаталог(ИОС.РодительскийКаталог(ПутьСценария)), "docs/OSGForms");
КонецЕсли;

ЗаписатьArrowLeft(ОбъединитьПути(КаталогTemp, "arrowLeft.png"));
ЗаписатьВолшебник(ОбъединитьПути(КаталогTemp, "Волшебник.jpg"));
ЗаписатьTimes(ОбъединитьПути(КаталогTemp, "times.ttf"));
ЗаписатьTahoma(ОбъединитьПути(КаталогTemp, "tahoma.ttf"));
ЗаписатьMtcorsva(ОбъединитьПути(КаталогTemp, "mtcorsva.ttf"));

// Важно для каждого запуска теста библиотеку OneScriptGameForms.dll актуализировать, 
// поэтому скопируем её из первоисточника.
Источник = ОбъединитьПути(ИОС.РодительскийКаталог(ИОС.РодительскийКаталог(ПутьСценария)), "111\OneScriptGameForms\OneScriptGameForms\bin\Debug\net8.0\OneScriptGameForms.dll");
Назначение = ОбъединитьПути(КаталогTemp, "OneScriptGameForms.dll");
Попытка
	КопироватьФайл(Источник, Назначение);
Исключение
КонецПопытки;

Источник = ОбъединитьПути(ИОС.РодительскийКаталог(ИОС.РодительскийКаталог(ПутьСценария)), "Scripts\OsGForms.exe");
Назначение = ОбъединитьПути(КаталогTemp, "OsGForms.exe");
Попытка
	КопироватьФайл(Источник, Назначение);
Исключение
КонецПопытки;

// Устанавливаем оставшиеся переменные.
КоличествоЗаданий = Новый Массив();
БлокировкаРесурса1 = Новый БлокировкаРесурса(КоличествоЗаданий);
Сбойных = 0;
Всего = 0;
НачальныйНомерФайла = 0;

ЗапускКодов();

// Ждём завершения всех заданий
Колич = КоличествоЗаданий.Количество();
Счетчик = 0;
СтараяСтрока = "";
Пока Колич > 0 и Счетчик < 80 Цикл
    Приостановить(3000);
	Колич = КоличествоЗаданий.Количество();
	НоваяСтрока = "Незавершено = " + Колич + Символы.ПС;
	
	БлокировкаРесурса1.Заблокировать();
	Для А = 0 По КоличествоЗаданий.ВГраница() Цикл
		Эл = КоличествоЗаданий.Получить(А);
		НоваяСтрока = НоваяСтрока + Эл + Символы.ПС;
	КонецЦикла;
	БлокировкаРесурса1.Разблокировать();
	
	Если Не СтараяСтрока = НоваяСтрока Тогда
		Сообщить("" + Символы.ПС + НоваяСтрока);
	КонецЕсли;
	СтараяСтрока = НоваяСтрока;
	Счетчик = Счетчик + 1;
КонецЦикла;

Сообщить("==========================================================");
Сообщить("Сбойных = " + Сбойных);
Сообщить("Всего = " + Всего);

Сообщить("Выполнено за: " + ((ТекущаяУниверсальнаяДатаВМиллисекундах() - Таймер)/1000)/60 + " мин.");
ЗавершитьРаботу(0);
