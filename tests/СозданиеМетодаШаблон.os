КонецПроцедуры//СоздатьМетод

Процедура Сортировать_Methods()
	Список = Новый СписокЗначений();
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ВыходнойКаталог + "\OSGForms." + КлассИмяEn + "Methods.html");
	Стр = ТекстДок.ПолучитьТекст();
	М = СтрНайтиМежду(Стр, 
		"<tbody>", 
		"</tbody>", Ложь, );
	Если М.Количество() > 0 Тогда
		// Сообщить("" + М[1]);
		ПодстрокаПоиска = М[1];
		М2 = СтрНайтиМежду(М[1], "                    <tr vAlign=top>", "</tr>", Ложь, );
		Для А2 = 0 По М2.ВГраница() Цикл
			// Сообщить("" + М2[А2]);
			М3 = СтрНайтиМежду(М2[А2], "html"">", "</a>", , );
			Если М3.Количество() > 0 Тогда
				// Сообщить("М3[0] = " + М3[0]);
				Список.Добавить(М2[А2], СтрЗаменить(М3[0], "&nbsp;", " "));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Список.СортироватьПоПредставлению();
	ПодстрокаЗамены = "";
	Для А = 0 По Список.Количество() - 1 Цикл
		// Сообщить("==" + Список.Получить(А).Значение);
		ПодстрокаЗамены = ПодстрокаЗамены + Список.Получить(А).Значение + "
		|";
	КонецЦикла;
	ПодстрокаЗамены = "<tbody>					
	|" + ПодстрокаЗамены + "                </tbody>";
	// Сообщить("=======================================");
	// Сообщить("" + ПодстрокаПоиска);
	// Сообщить("=======================================");
	// Сообщить("" + ПодстрокаЗамены);
	
	Стр = СтрЗаменить(Стр, ПодстрокаПоиска, ПодстрокаЗамены);
	ИмяФайла = ВыходнойКаталог + "\OSGForms." + КлассИмяEn + "Methods.html";
	ТекстДок.УстановитьТекст(Стр);
	ТекстДок.Записать(ИмяФайла);
КонецПроцедуры

Процедура КопироватьМетод() Экспорт
	БезСообщения = Истина;
	ОчиститьПараметры();
	
	МетодРус = СтрРазделить(ПолеВыбора24.Текст, " ")[0];
	МетодАнгл = СтрРазделить(ПолеВыбора24.Текст, " ")[1];
	КлассМетодаРус = СтрРазделить(ПолеВыбора24.Текст, " ")[2];
	КлассМетодаАнгл = СтрРазделить(ПолеВыбора24.Текст, " ")[3];
    // Сообщить("МетодРус = " + МетодРус);
    // Сообщить("МетодАнгл = " + МетодАнгл);
    // Сообщить("КлассМетодаРус = " + КлассМетодаРус);
    // Сообщить("КлассМетодаАнгл = " + КлассМетодаАнгл);
	
	ТекстДок = Новый ТекстовыйДокумент;
	// OSGForms.ButtonToStringMethod.html
	ФайлМетода = "C:\444\OneScriptGameForms\docs\OSGForms\OSGForms." + КлассМетодаАнгл + МетодАнгл + "Method.html";
	КаталогНаДиске = Новый Файл(ФайлМетода);
    Если Не (КаталогНаДиске.Существует()) Тогда
		Возврат;
	КонецЕсли;
	ТекстДок.Прочитать(ФайлМетода);
	СтрТекстДок = ТекстДок.ПолучитьТекст();
	// Сообщить("СтрТекстДок = " + СтрТекстДок);
	// МетодОписание
	М = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Описание</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	МетодОписание = СтрНайтиМежду(М[0], "<p>", "</p>", , )[0];
	ПолеВвода3.Текст = СокрЛП(МетодОписание);
	// Сообщить("МетодОписание = " + МетодОписание);
	
	МетодИмяРус = СокрЛП(МетодРус);
	ПолеВвода4.Текст = СокрЛП(МетодИмяРус);
	// Сообщить("МетодИмяРус = " + МетодИмяРус);
	
	МетодИмяEn = МетодАнгл;
	ПолеВвода5.Текст = МетодИмяEn;
	// Сообщить("МетодИмяEn = " + МетодИмяEn);
	
	М1 = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Возвращаемое значение</h4>", "<h4 class=dtH4>Описание</h4>", Ложь, );
	Если М1.Количество() > 0 Тогда
		// Сообщить("М1[0] = " + М1[0]);
		М2 = СтрНайтиМежду(М1[0], "<p>", "</p>", , );
		// ВозвращаемоеЗначениеТип
		Если М2.Количество() > 0 Тогда
			// Сообщить("М2[0] = " + М2[0]);
			ВозвращаемоеЗначениеТип = М2[0];
			ПолеВыбора2.Текст = СокрЛП(ВозвращаемоеЗначениеТип);
		КонецЕсли;
		// Сообщить("М3[0] = " + М3[0]);
		// ВозвращаемоеЗначениеОписание = СокрЛП(ПолеВвода8.Текст);
		ВозвращаемоеЗначениеОписание = "";
		Для А2 = 1 По М2.ВГраница() Цикл
			// Сообщить("М2[А2] = " + М2[А2]);
			ВозвращаемоеЗначениеОписание = ВозвращаемоеЗначениеОписание + М2[А2] + Ф.Окружение().НоваяСтрока;
		КонецЦикла;
		ПолеВвода8.Текст = СокрЛП(ВозвращаемоеЗначениеОписание);
	КонецЕсли;
	
	// <h4 class=dtH4>Параметры</h4>
	// <h4 class=dtH4>Возвращаемое значение</h4>
	М_Параметров.Очистить();
	М4 = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Параметры</h4>", "<h4 class=dtH4>Возвращаемое значение</h4>", , );
	Если М4.Количество() > 0 Тогда
		// Сообщить("М4[0] = " + М4[0]);
		Стр5 = М4[0];
		Стр5 = СтрЗаменить(Стр5, "<dl>", "");
		Стр5 = СтрЗаменить(Стр5, "</dl>", "");
		Стр5 = СокрЛП(Стр5);
		Стр5 = СтрЗаменить(Стр5, "<dt>", "ййййй") + "ййййй";
		// Сообщить("Стр5 = " + Стр5);
		М5 = СтрНайтиМежду(Стр5, "ййййй", "ййййй", , );
		Если М5.Количество() > 0 Тогда
			// <i>Игрек</i> (обязательный)</dt>
            // <dd>Тип: Число.</dd>
            // <dd>Координата по оси игрек.</dd>
			Для А5 = 0 По М5.ВГраница() Цикл
				Стр6 = СокрЛП(М5[А5]);
				// Сообщить("Стр6 = " + Стр6);
				// Сообщить("================");
				Парам1Имя = СтрНайтиМежду(Стр6, "<i>", "</i>", , )[0];
				Парам1Обязательный = СтрНайтиМежду(Стр6, "</i> (", ")</dt>", , )[0];
				Парам1Тип = СтрНайтиМежду(Стр6, "<dd>", "</dd>", , )[0];
				Парам1Описание = СтрНайтиМежду(Стр6, "<dd>", "</dd>", , )[1];
				М_Параметров.Добавить(Парам1Имя + ";;;" + Парам1Обязательный + ";;;" + Парам1Тип + ";;;" + Парам1Описание);
				// Сообщить("Парам1Имя = " + Парам1Имя);
				// Сообщить("Парам1Обязательный = " + Парам1Обязательный);
				// Сообщить("Парам1Тип = " + Парам1Тип);
				// Сообщить("Парам1Описание = " + Парам1Описание);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Для А8 = 0 По М_Параметров.ВГраница() Цикл
		// Сообщить("Парам = " + М_Параметров[А8]);
		М9 = РазобратьСтроку(М_Параметров[А8], ";;;");
		// Парам = Игрек;;;обязательный;;;Тип: Число.;;;Координата по оси игрек.
		Парам1Имя = СокрЛП(М9[0]);
		Парам1Обязательный = СокрЛП(М9[1]);
		Парам1Тип = СокрЛП(М9[2]);
		Парам1Описание = СокрЛП(М9[3]);
		// Сообщить("=====================");
		// Сообщить("Парам1Имя = " + Парам1Имя);
		// Сообщить("Парам1Обязательный = " + Парам1Обязательный);
		// Сообщить("Парам1Тип = " + Парам1Тип);
		// Сообщить("Парам1Описание = " + Парам1Описание);
		
		Если А8 = 0 Тогда
			ПолеВвода9.Текст = Парам1Имя;
			ПолеВыбора1.Текст = Парам1Обязательный;
			ПолеВыбора3.Текст = Парам1Тип;
			ПолеВвода10.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 1 Тогда
			ПолеВвода12.Текст = Парам1Имя;
			ПолеВыбора5.Текст = Парам1Обязательный;
			ПолеВыбора4.Текст = Парам1Тип;
			ПолеВвода11.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 2 Тогда
			ПолеВвода14.Текст = Парам1Имя;
			ПолеВыбора7.Текст = Парам1Обязательный;
			ПолеВыбора6.Текст = Парам1Тип;
			ПолеВвода13.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 3 Тогда
			ПолеВвода16.Текст = Парам1Имя;
			ПолеВыбора9.Текст = Парам1Обязательный;
			ПолеВыбора8.Текст = Парам1Тип;
			ПолеВвода15.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 4 Тогда
			ПолеВвода18.Текст = Парам1Имя;
			ПолеВыбора11.Текст = Парам1Обязательный;
			ПолеВыбора10.Текст = Парам1Тип;
			ПолеВвода17.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 5 Тогда
			ПолеВвода20.Текст = Парам1Имя;
			ПолеВыбора13.Текст = Парам1Обязательный;
			ПолеВыбора12.Текст = Парам1Тип;
			ПолеВвода19.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 6 Тогда
			ПолеВвода22.Текст = Парам1Имя;
			ПолеВыбора15.Текст = Парам1Обязательный;
			ПолеВыбора14.Текст = Парам1Тип;
			ПолеВвода21.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 7 Тогда
			ПолеВвода24.Текст = Парам1Имя;
			ПолеВыбора17.Текст = Парам1Обязательный;
			ПолеВыбора16.Текст = Парам1Тип;
			ПолеВвода23.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 8 Тогда
			ПолеВвода26.Текст = Парам1Имя;
			ПолеВыбора19.Текст = Парам1Обязательный;
			ПолеВыбора18.Текст = Парам1Тип;
			ПолеВвода25.Текст = Парам1Описание;
		КонецЕсли;
		Если А8 = 9 Тогда
			ПолеВвода28.Текст = Парам1Имя;
			ПолеВыбора21.Текст = Парам1Обязательный;
			ПолеВыбора20.Текст = Парам1Тип;
			ПолеВвода27.Текст = Парам1Описание;
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

Процедура ОчиститьПараметры() Экспорт
	ОкноСообщений1 = Ф.ОкноСообщений();
	Если Не БезСообщения Тогда
		Рез = ОкноСообщений1.Показать("Точно очистить???", "Заголовок");
		Если Не Рез = Ф.РезультатДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для А = 0 По ПанельВкладок1.Вкладки.Количество - 1 Цикл
		Вкладка = ПанельВкладок1.Вкладки(А);
		Для А1 = 0 По Вкладка.ЭлементыУправления.Количество - 1 Цикл
			Элемент = Вкладка.ЭлементУправления(А1);
			Если ТипЗнч(Элемент) = Тип("КлПолеВвода") или ТипЗнч(Элемент) = Тип("КлПолеВыбора") Тогда
				Элемент.Текст = "";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	БезСообщения = Ложь;
КонецПроцедуры

Процедура НаследоватьМетод() Экспорт
	БезСообщения = Истина;
	ОчиститьПараметры();
	
	МетодРус = СтрРазделить(ПолеВыбора25.Текст, " ")[0];
	МетодАнгл = СтрРазделить(ПолеВыбора25.Текст, " ")[1];
	КлассМетодаРус = СтрРазделить(ПолеВыбора25.Текст, " ")[2];
	КлассМетодаАнгл = СтрРазделить(ПолеВыбора25.Текст, " ")[3];
    // Сообщить("МетодРус = " + МетодРус);
    // Сообщить("МетодАнгл = " + МетодАнгл);
    // Сообщить("КлассМетодаРус = " + КлассМетодаРус);
    // Сообщить("КлассМетодаАнгл = " + КлассМетодаАнгл);
	
	ТекстДок = Новый ТекстовыйДокумент;
	// OSGForms.ButtonToStringMethod.html
	ФайлМетода = "C:\444\OneScriptGameForms\docs\OSGForms\OSGForms." + КлассМетодаАнгл + МетодАнгл + "Method.html";
	КаталогНаДиске = Новый Файл(ФайлМетода);
    Если Не (КаталогНаДиске.Существует()) Тогда
		Возврат;
	КонецЕсли;
	ТекстДок.Прочитать(ФайлМетода);
	СтрТекстДок = ТекстДок.ПолучитьТекст();
	// Сообщить("СтрТекстДок = " + СтрТекстДок);
	// МетодОписание
	М = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Описание</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	МетодОписание = СтрНайтиМежду(М[0], "<p>", "</p>", , )[0];
	ПолеВвода3.Текст = СокрЛП(МетодОписание);
	// Сообщить("МетодОписание = " + МетодОписание);
	
	МетодИмяРус = СокрЛП(МетодРус);
	ПолеВвода4.Текст = СокрЛП(МетодИмяРус);
	// Сообщить("МетодИмяРус = " + МетодИмяРус);
	
	МетодИмяEn = МетодАнгл;
	ПолеВвода5.Текст = МетодИмяEn;
	// Сообщить("МетодИмяEn = " + МетодИмяEn);
	
	М1 = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Возвращаемое значение</h4>", "<h4 class=dtH4>Описание</h4>", Ложь, );
	Если М1.Количество() > 0 Тогда
		// Сообщить("М1[0] = " + М1[0]);
		М2 = СтрНайтиМежду(М1[0], "<p>", "</p>", , );
		// ВозвращаемоеЗначениеТип
		Если М2.Количество() > 0 Тогда
			// Сообщить("М2[0] = " + М2[0]);
			ВозвращаемоеЗначениеТип = М2[0];
			ПолеВыбора2.Текст = СокрЛП(ВозвращаемоеЗначениеТип);
		КонецЕсли;
		// Сообщить("М3[0] = " + М3[0]);
		// ВозвращаемоеЗначениеОписание = СокрЛП(ПолеВвода8.Текст);
		ВозвращаемоеЗначениеОписание = "";
		Для А2 = 1 По М2.ВГраница() Цикл
			// Сообщить("М2[А2] = " + М2[А2]);
			ВозвращаемоеЗначениеОписание = ВозвращаемоеЗначениеОписание + М2[А2] + Ф.Окружение().НоваяСтрока;
		КонецЦикла;
		ПолеВвода8.Текст = СокрЛП(ВозвращаемоеЗначениеОписание);
	КонецЕсли;
	
	// <h4 class=dtH4>Параметры</h4>
	// <h4 class=dtH4>Возвращаемое значение</h4>
	М_Параметров.Очистить();
	М4 = СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Параметры</h4>", "<h4 class=dtH4>Возвращаемое значение</h4>", , );
	Если М4.Количество() > 0 Тогда
		// Сообщить("М4[0] = " + М4[0]);
		Стр5 = М4[0];
		Стр5 = СтрЗаменить(Стр5, "<dl>", "");
		Стр5 = СтрЗаменить(Стр5, "</dl>", "");
		Стр5 = СокрЛП(Стр5);
		Стр5 = СтрЗаменить(Стр5, "<dt>", "ййййй") + "ййййй";
		// Сообщить("Стр5 = " + Стр5);
		М5 = СтрНайтиМежду(Стр5, "ййййй", "ййййй", , );
		Если М5.Количество() > 0 Тогда
			// <i>Игрек</i> (обязательный)</dt>
            // <dd>Тип: Число.</dd>
            // <dd>Координата по оси игрек.</dd>
			Для А5 = 0 По М5.ВГраница() Цикл
				Стр6 = СокрЛП(М5[А5]);
				// Сообщить("Стр6 = " + Стр6);
				// Сообщить("================");
				Парам1Имя = СтрНайтиМежду(Стр6, "<i>", "</i>", , )[0];
				Парам1Обязательный = СтрНайтиМежду(Стр6, "</i> (", ")</dt>", , )[0];
				Парам1Тип = СтрНайтиМежду(Стр6, "<dd>", "</dd>", , )[0];
				Парам1Описание = СокрЛП(СтрНайтиМежду(Стр6, "<dd>", "</dd>", , )[1]);
				М_Параметров.Добавить(Парам1Имя + ";;;" + Парам1Обязательный + ";;;" + Парам1Тип + ";;;" + Парам1Описание);
				// Сообщить("Парам1Имя = " + Парам1Имя);
				// Сообщить("Парам1Обязательный = " + Парам1Обязательный);
				// Сообщить("Парам1Тип = " + Парам1Тип);
