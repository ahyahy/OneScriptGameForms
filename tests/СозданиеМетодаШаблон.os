Процедура НачальноеЗаполнениеФормы()
	ПолеВыбора22.Текст = "Узел3д Node3D"; // Класс
	ПолеВвода3.Текст = "Удаляет дочерний элемент из коллекции дочерних родителя. При этом сам элемент вместе со своими дочерними элементами из игровых форм <b>НЕ удаляется</b>."; // МетодОписание
	ПолеВвода4.Текст = "УдалитьДочерний"; // МетодИмяРус
	ПолеВвода5.Текст = "RemoveChild"; // МетодИмяEn
	ПолеВыбора2.Текст = ""; // ВозвращаемоеЗначениеТип
	ПолеВвода8.Текст = ""; // ВозвращаемоеЗначениеОписание
	ПолеВыбора23.Текст = "Узел Node"; // унаследовано от
	
	Для А = 0 По ПанельВкладок1.Вкладки.Количество - 1 Цикл
		Вкладка = ПанельВкладок1.Вкладки(А);
		Для А1 = 0 По Вкладка.ЭлементыУправления.Количество - 1 Цикл
			Элемент = Вкладка.ЭлементУправления(А1);
			Если ТипЗнч(Элемент) = Тип("КлПолеВвода") или ТипЗнч(Элемент) = Тип("КлПолеВыбора") Тогда
				Элемент.Текст = "";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнитьПолеВыбора22();
	ЗаполнитьПолеВыбора24();
	ЗаполнитьПолеВыбораТип();
	Флажок1.Помечен = Ложь;
	
	Ф.ПередатьУправление();
	// Приостановить(1000);
	Кн1_Нажатие();
КонецПроцедуры

Процедура ЗаполнитьПолеВыбораТип()
	Список14 = Новый СписокЗначений();
	Список14 = ДобавитьПеречисления(Список14);

	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать("C:\444\OneScriptGameForms\docs\doc.html");
	Стр = ТекстДок.ПолучитьТекст();
	М = СтрНайтиМежду(Стр, 
			"menu3", 
			"</summary>", 
			, );
	Если М.Количество() > 0 Тогда
		// Сообщить("М[0] = " + М[0]);
		Для А = 0 По М.ВГраница() Цикл
			М2 = СтрНайтиМежду(М[А], "right"">", "</a>", , );
			Если М2.Количество() > 0 Тогда
				// Сообщить("М2[0] = " + М2[0]);
				Для А2 = 0 По М2.ВГраница() Цикл
					СтрКласс = М2[0];
					СтрКласс = СтрЗаменить(СтрКласс, "(", "");
					СтрКласс = СтрЗаменить(СтрКласс, ")", "");
					// Сообщить("" + М2[0]);
					
					СтрКласс2En = СтрНайтиМежду(М2[0], "(", ")", , )[0];
					Фрагмент33 = "№" + М2[0];
					СтрКласс2Ru = СокрЛП(СтрНайтиМежду(Фрагмент33, "№", " (", , )[0]);
					СтрКласс2 = "Тип: <a href=""OSGForms." + СтрКласс2En + ".html"">" + СтрКласс2Ru + "&nbsp;(" + СтрКласс2En + ")</a>.";
					Если Список14.НайтиПоЗначению(СтрКласс2) = Неопределено Тогда
						Список14.Добавить(СтрКласс2, СтрКласс2Ru);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
						
	Список14.СортироватьПоПредставлению();
	Для А45 = 0 По Список14.Количество() - 1 Цикл
		ПолеВыбора2.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора3.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора4.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора6.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора8.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора10.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора12.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора14.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора16.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора18.Элементы.Добавить(Список14.Получить(А45).Значение);
		ПолеВыбора20.Элементы.Добавить(Список14.Получить(А45).Значение);
	КонецЦикла;
КонецПроцедуры

Функция ДобавитьПеречисления(СписокДляПеречислений)
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать("C:\444\OneScriptGameForms\docs\doc.html");
	Стр56 = ТекстДок.ПолучитьТекст();
	М56 = СтрНайтиМежду(Стр56, 
			"Enumeration.html"" target=""right"">", 
			"</a>", 
			, );
	Если М56.Количество() > 0 Тогда
		// Сообщить("М56[0] = " + М56[0]);
		Для А57 = 0 По М56.ВГраница() Цикл
			СтрПеречисл = М56[А57];
			// Сообщить("СтрПеречисл = " + СтрПеречисл);
			
			СтрКласс2En = СтрНайтиМежду(СтрПеречисл, "(", ")", , )[0];
			Фрагмент33 = "№" + СтрПеречисл;
			СтрКласс2Ru = СокрЛП(СтрНайтиМежду(Фрагмент33, "№", " (", , )[0]);
			СтрКласс2 = "Тип: <a href=""OSGForms." + СтрКласс2En + "Enumeration.html"">" + СтрКласс2Ru + "&nbsp;(" + СтрКласс2En + ")</a>.";
			Если СписокДляПеречислений.НайтиПоЗначению(СтрКласс2) = Неопределено Тогда
				СписокДляПеречислений.Добавить(СтрКласс2, СтрКласс2Ru);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СписокДляПеречислений;
КонецФункции

Процедура ЗаполнитьПолеВыбора24()
	Список = Новый СписокЗначений();
	ВыбранныеФайлы = НайтиФайлы("C:\444\OneScriptGameForms\docs\OSGForms\", "*.html", Истина);
	Для А = 0 По ВыбранныеФайлы.ВГраница() Цикл
		Если СтрНайти(ВыбранныеФайлы[А].Имя, "Methods.html") > 0 Тогда
			// Сообщить("" + ВыбранныеФайлы[А].ПолноеИмя);
			ТекстДок = Новый ТекстовыйДокумент;
			ТекстДок.Прочитать(ВыбранныеФайлы[А].ПолноеИмя);
			Стр = ТекстДок.ПолучитьТекст();
			
			КлассРусАнгл = СтрНайтиМежду(Стр, "<h1 class=dtH1>", "Методы</h1>", , )[0];
			КлассРусАнгл = СтрЗаменить(КлассРусАнгл, "&nbsp;", " ");
			КлассРусАнгл = СтрЗаменить(КлассРусАнгл, "(", "");
			КлассРусАнгл = СтрЗаменить(КлассРусАнгл, ")", "");
			КлассРусАнгл = СокрЛП(КлассРусАнгл);
			
			М2 = СтрНайтиМежду(Стр, "<tbody>", "</tbody>", , );
			Если М2.Количество() > 0 Тогда
				// Сообщить("" + М2[1]);
				М3 = СтрНайтиМежду(М2[1], "<tr vAlign=top>", "</tr>", Ложь, );
				Для А3 = 0 По М3.ВГраница() Цикл
					// Сообщить("" + М3[А3]);
					М4 = СтрНайтиМежду(М3[А3], "html"">", "</a>", , );
					Если М4.Количество() > 0 Тогда
						Для А4 = 0 По М4.ВГраница() Цикл
							// Сообщить("М4[0] = " + М4[0]);
							ИмяМетода = М4[0];
							ИмяМетода = СтрЗаменить(ИмяМетода, "&nbsp;", " ");
							ИмяМетода = СтрЗаменить(ИмяМетода, "(", "");
							ИмяМетода = СтрЗаменить(ИмяМетода, ")", "");
							
							Если Список.НайтиПоЗначению(ИмяМетода) = Неопределено Тогда
								Список.Добавить(ИмяМетода, КлассРусАнгл);
								// Сообщить("" + ИмяМетода + " " + КлассРусАнгл);
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Список.СортироватьПоЗначению();
	Для А = 0 По Список.Количество() - 1 Цикл
		ПолеВыбора24.Элементы.Добавить(Список.Получить(А).Значение + " " + Список.Получить(А).Представление);
	КонецЦикла;
КонецПроцедуры

