Процедура СравнениеВыгрузкиИгровыхФорм()
	Таймер = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ФайлыВыгрузки = НайтиФайлы("C:\444\OneScriptGameForms\Scripts\ВыгруженныеОбъекты", "*.cs", Ложь);
	Если ФайлыВыгрузки.Количество() > 0 Тогда
		Для А = 0 По ФайлыВыгрузки.ВГраница() Цикл
			// Сообщить("Файл " + А + " из " + ФайлыВыгрузки.ВГраница() + " - " + ФайлыВыгрузки[А].ПолноеИмя);
			ФайлНаДиске = Новый Файл("C:\444\OneScriptGameForms\111\OneScriptGameForms\OneScriptGameForms\" + ФайлыВыгрузки[А].Имя);
			Если ФайлНаДиске.Существует() Тогда
				Если Не ТекстовыеФайлыРавны(ФайлыВыгрузки[А].ПолноеИмя, ФайлНаДиске.ПолноеИмя) Тогда
					Сообщить("" + ФайлыВыгрузки[А].Имя);
				КонецЕсли;
			Иначе
				Сообщить("" + ФайлыВыгрузки[А].Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сообщить("Выполнено за: " + ((ТекущаяУниверсальнаяДатаВМиллисекундах()-Таймер)/1000)/60 + " мин.");
КонецПроцедуры

Функция ТекстовыеФайлыРавны(Путь1, Путь2)
	ТекстДок1 = Новый ТекстовыйДокумент;
	ТекстДок1.Прочитать(Путь1);
	Стр1 = ТекстДок1.ПолучитьТекст();
	ТекстДок2 = Новый ТекстовыйДокумент;
	ТекстДок2.Прочитать(Путь2);
	Стр2 = ТекстДок2.ПолучитьТекст();
	Если Не Стр1 = Стр2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

СравнениеВыгрузкиИгровыхФорм();
