// В файлах справки C:\444\OneScriptGameForms\docs\OSGForms\ находит страницы методов и свойств без тестовых кодов.

Процедура СтраницыБезТестовыхКодов()
	Таймер = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПодключитьВнешнююКомпоненту("OneScriptIntegrator.dll");
	ИОС = Новый ИнтеграторОдноСкрипта();
	
	ВыбранныеФайлы = НайтиФайлы("C:\444\OneScriptGameForms\docs\OSGForms", "*.html", Истина);
	БезТестов = 0;
	
	БезПримеров = 0;
	БезПолных = 0;
	БезТестовых = 0;
	СПримерами = 0;

	ВсегоНайдено = 0;
	Для А = 0 По ВыбранныеФайлы.ВГраница() Цикл
		// Сообщить("Файл " + А + " из " + ВыбранныеФайлы.ВГраница() + " - " + ВыбранныеФайлы[А].ПолноеИмя);
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ВыбранныеФайлы[А].ПолноеИмя);
		Стр = ТекстДок.ПолучитьТекст();
		// 
		М1 = ИОС.СтрНайтиМежду(Стр, "<h1 class=dtH1>", "</h1>", , );
		Если М1.Количество() > 0 Тогда
			Заголовок = ИОС.СтрНайтиМежду(Стр, "<h1 class=dtH1>", "</h1>", , ).Получить(0);
			Заголовок = СтрЗаменить(Заголовок, "&nbsp;", " ");
			М2 = ИОС.СтрНайтиМежду(Стр, "<h4 class=dtH4>Пример</h4>", "</pre>", Ложь, );
			Если М2.Количество() > 0 Тогда
				ВсегоНайдено = ВсегоНайдено + 1;
				Для А2 = 0 По М1.ВГраница() Цикл
					Если М2.Количество() > 0 Тогда
						СтрКода = ИОС.СтрНайтиМежду(Стр, "<pre class=code>", "</pre>", , )[0];
						Если СтрДлина(СокрЛП(СтрКода)) > 0 Тогда
							// Сообщить("пример есть " + ВыбранныеФайлы[А].ПолноеИмя + " " + Заголовок);
							СПримерами = СПримерами + 1;
						Иначе
							Сообщить("Нет примера " + ВыбранныеФайлы[А].ПолноеИмя + " " + Заголовок);
							БезПримеров = БезПримеров + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("=================================================");
	Сообщить("ВсегоНайдено = " + ВсегоНайдено);
	Сообщить("БезПримеров = " + БезПримеров);
	Сообщить("СПримерами = " + СПримерами);
	Сообщить("=================================================");
	
	Сообщить("Выполнено за: " + ((ТекущаяУниверсальнаяДатаВМиллисекундах() - Таймер)/1000)/60 + " мин.");
КонецПроцедуры//СтраницыБезТестовыхКодов()

СтраницыБезТестовыхКодов();
