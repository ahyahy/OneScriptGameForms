Перем Ф, ИОС, СтрКласса, КаталогСправки;
Перем ПолеВыбора4, Кнопка1, Флажок1;

Процедура Кн_Нажатие() Экспорт
	Кнопка1.Доступность = Ложь;
	Если Флажок1.Помечен = Истина Тогда
		Для А = 0 По ПолеВыбора4.Элементы.Количество - 1 Цикл
			ПолеВыбора4.ИндексВыбранного = А;
			// Сообщить("ПолеВыбора4.Текст = " + ПолеВыбора4.Текст);
			ПолеВыбора4.Обновить();
			// Приостановить(1000);
			Ф.ПередатьУправление();
			
			СтрКласса = СокрЛП(ПолеВыбора4.Текст);
			Если СтрКласса = "" Тогда
				Ф.ОкноСообщений().Показать("Не выбран класс - наследник.", "Выбор класса");
				Возврат;
			КонецЕсли;
			СтрКласса = СтрЗаменить(СтрКласса, " ", " (");
			СтрКласса = СтрКласса + ") Класс";
			СоздатьНаследуемыеМетоды();
		КонецЦикла;
		Ф.ОкноСообщений().Показать("Все классы обработаны!", "Завершено");
	Иначе
		СтрКласса = СокрЛП(ПолеВыбора4.Текст);
		Если СтрКласса = "" Тогда
			Ф.ОкноСообщений().Показать("Не выбран класс - наследник.", "Выбор класса");
			Возврат;
		КонецЕсли;
		СтрКласса = СтрЗаменить(СтрКласса, " ", " (");
		СтрКласса = СтрКласса + ") Класс";
		СоздатьНаследуемыеМетоды();
		Ф.ОкноСообщений().Показать("Все классы обработаны!", "Завершено");
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПолеВыбора4()
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать("C:\444\OneScriptGameForms\docs\doc.html");
	Стр = ТекстДок.ПолучитьТекст();
	М = ИОС.СтрНайтиМежду(Стр, 
			"menu3", 
			"</summary>", 
			, );
	Если М.Количество() > 0 Тогда
		// Сообщить("М[0] = " + М[0]);
		Для А = 0 По М.ВГраница() Цикл
			М2 = ИОС.СтрНайтиМежду(М[А], "right"">", "</a>", , );
			Если М2.Количество() > 0 Тогда
				// Сообщить("М2[0] = " + М2[0]);
				Для А2 = 0 По М2.ВГраница() Цикл
					СтрКласс = М2[0];
					СтрКласс = СтрЗаменить(СтрКласс, "(", "");
					СтрКласс = СтрЗаменить(СтрКласс, ")", "");
					ПолеВыбора4.Элементы.Добавить(СтрКласс);
					// Сообщить("" + М2[0]);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПостроитьСписокРодителей(ПутьФайлHTMLКласса)
	СписокРодителей = Новый СписокЗначений();
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ПутьФайлHTMLКласса);
	Стр = ТекстДок.ПолучитьТекст();
	// <h4 class=dtH4>Иерархия</h4>
	// <h4 class=dtH4>Смотрите также</h4>
	Иерархия1 = ИОС.СтрНайтиМежду(Стр, "<h4 class=dtH4>Иерархия</h4>", "<h4 class=dtH4>Смотрите также</h4>", , )[0];
	Наследник = ИОС.СтрНайтиМежду(Иерархия1, "<b>", "</b>", , )[0]; // <b>Кнопка (Button)</b>
	Родители = ИОС.СтрНайтиМежду(Иерархия1, "<p>", "<b>", , );
	СписокРодителей = Новый СписокЗначений();
	Если Родители.Количество() > 0 Тогда
		Для А = 0 По Родители.ВГраница() Цикл
			СтрокиРодителя = ИОС.СтрНайтиМежду(Родители[А], "<a", "</a>", );
			Если СтрокиРодителя.Количество() > 0 Тогда
				Для А1 = 0 По СтрокиРодителя.ВГраница() Цикл
					СтрокаРодителя = СтрокиРодителя[А1];
					// Сообщить("СтрокаРодителя = " + СтрокаРодителя);
					Путь = ИОС.СтрНайтиМежду(СтрокаРодителя, "=""", """>")[0];
					Путь = ОбъединитьПути(КаталогСправки, Путь);
					Представление = ИОС.СтрНайтиМежду(СтрокаРодителя, """>", ")")[0] + ")";
					СписокРодителей.Добавить(Путь, Представление);
					// Сообщить("1= " + Путь);
					// Сообщить("2= " + Представление);
					// Сообщить("=====================================");
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокРодителей;
КонецФункции//ПостроитьСписокРодителей

Функция ПостроитьСписокМетодовИзСправки(ПутьФайлHTMLМетодов)
	СписокМетодовИзСправки = Новый СписокЗначений();
	ФайлМетода = Новый Файл(ПутьФайлHTMLМетодов);
	Если Не ФайлМетода.Существует() Тогда
		Возврат СписокМетодовИзСправки;
	КонецЕсли;
	
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ПутьФайлHTMLМетодов);
	Стр = ТекстДок.ПолучитьТекст();
	//Находим текст таблицы.
	М = ИОС.СтрНайтиМежду(Стр, "<tr vAlign=top>", "</tr>", , );
	Если М.Количество() > 0 Тогда
		Для А = 0 По М.ВГраница() Цикл
			// Проверим существует ли файл метода.
			ПолныйПуть = ИОС.СтрНайтиМежду(М[А], "<a href=""", """>", , )[0];
			ПолныйПуть = ОбъединитьПути(КаталогСправки, ПолныйПуть);
			ФайлМетода = Новый Файл(ПолныйПуть);
			Если Не ФайлМетода.Существует() Тогда
				Сообщить("Не найден файл метода " + ПолныйПуть);
				Продолжить;
			КонецЕсли;
			МетодРус = ИОС.СтрНайтиМежду(М[А], "Method.html"">", "&nbsp;(", , )[0];
			МетодАнгл = ИОС.СтрНайтиМежду(М[А], "(", ")", , )[0];
			МетодИзСправки = МетодРус + " (" + МетодАнгл + ")";
			Унаследовано = СокрЛП(ИОС.СтрНайтиМежду(М[А], "</a>", "</td>", , )[0]);
			СписокМетодовИзСправки.Добавить(МетодИзСправки, Унаследовано);
			// Сообщить("МетодИзСправки = " + МетодИзСправки);
			// Сообщить("Унаследовано = " + Унаследовано);
			// Сообщить("=================================================");
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокМетодовИзСправки;
КонецФункции//ПостроитьСписокМетодовИзСправки

Процедура СоздатьУнаследованныйМетод(ПутьДоМетодаРодителя, МетодРодителя, ТекущийРодитель, Наследник, СтрКлассаEn)
	// Сообщить("=== ПутьДоМетодаРодителя " + ПутьДоМетодаРодителя);

	МетодРус = СтрРазделить(МетодРодителя, " ")[0];
	МетодАнгл = СтрРазделить(МетодРодителя, " ")[1];
	МетодАнгл = СтрЗаменить(МетодАнгл, "(", "");
	МетодАнгл = СтрЗаменить(МетодАнгл, ")", "");
    // Сообщить("МетодРус = " + МетодРус);
    // Сообщить("МетодАнгл = " + МетодАнгл);
	КлассРодителяРус = СтрРазделить(ТекущийРодитель, " ")[0];
	КлассРодителяАнгл = СтрРазделить(ТекущийРодитель, " ")[1];
	КлассРодителяАнгл = СтрЗаменить(КлассРодителяАнгл, "(", "");
	КлассРодителяАнгл = СтрЗаменить(КлассРодителяАнгл, ")", "");
    // Сообщить("КлассРодителяРус = " + КлассРодителяРус);
    // Сообщить("КлассРодителяАнгл = " + КлассРодителяАнгл);
	
	ТекстДок = Новый ТекстовыйДокумент;
	ФайлМетод = "C:\444\OneScriptGameForms\docs\OSGForms\OSGForms." + КлассРодителяАнгл + МетодАнгл + "Method.html";
	КаталогНаДиске = Новый Файл(ФайлМетод);
    Если Не (КаталогНаДиске.Существует()) Тогда
		Возврат;
	КонецЕсли;
	ТекстДок.Прочитать(ФайлМетод);
	СтрТекстДок = ТекстДок.ПолучитьТекст();
	// Сообщить("СтрТекстДок = " + СтрТекстДок);
	
	МетодОписание = "";
	М = ИОС.СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Описание</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	Если М.Количество() > 0 Тогда
		М2 = ИОС.СтрНайтиМежду(М[0], "<p>", "</p>", , );
		Если М2.Количество() > 0 Тогда
			МетодОписание = М2[0];
		КонецЕсли;
	КонецЕсли;
	
	ВозвращаемоеЗначениеТип = "";
	ВозвращаемоеЗначениеОписание = "";
	М3 = ИОС.СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Возвращаемое значение</h4>", "<h4 class=dtH4>Описание</h4>", , );
	Если М3.Количество() > 0 Тогда
		М4 = ИОС.СтрНайтиМежду(М3[0], "<p>", "</p>", , );
		Если М4.Количество() > 0 Тогда
			ВозвращаемоеЗначениеТип = М4[0];
			Если М4.Количество() > 1 Тогда
				ВозвращаемоеЗначениеОписание = М4[1];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Текст_Класс = Наследник; // Класс
	Текст_МетодОписание = СтрЗаменить(МетодОписание, """", """"""); // МетодОписание
	Текст_МетодИмяРус = МетодРус; // МетодИмяРус
	Текст_МетодИмяEn = МетодАнгл; // МетодИмяEn
	Текст_ВозвращаемоеЗначениеТип = СтрЗаменить(ВозвращаемоеЗначениеТип, """", """"""); // ВозвращаемоеЗначениеТип
	Текст_ВозвращаемоеЗначениеОписание = СтрЗаменить(ВозвращаемоеЗначениеОписание, """", """"""); // ВозвращаемоеЗначениеОписание
	// Сообщить("Текст_Класс = " + Текст_Класс);
	// Сообщить("Текст_МетодОписание = " + Текст_МетодОписание);
	// Сообщить("Текст_МетодИмяРус = " + Текст_МетодИмяРус);
	// Сообщить("Текст_МетодИмяEn = " + Текст_МетодИмяEn);
	// Сообщить("Текст_ВозвращаемоеЗначениеТип = " + Текст_ВозвращаемоеЗначениеТип);
	// Сообщить("Текст_ВозвращаемоеЗначениеОписание = " + Текст_ВозвращаемоеЗначениеОписание);
	// Сообщить("==========================================");
	
	ИсходныйФайл = "C:\444\OneScriptGameForms\ФабрикаHtml\СозданиеМетода.os";
	КопияФайла = "C:\444\OneScriptGameForms\ФабрикаHtml\СозданиеМетодаШаблон.os";
	КопироватьФайл(ИсходныйФайл, КопияФайла);
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(КопияФайла);
	Стр = ТекстДок.ПолучитьТекст();
	
	ПодстрокаПоиска = 
	"Процедура НачальноеЗаполнениеФормы()
	|	ПолеВыбора22.Текст = """"; // Класс
	|	ПолеВвода3.Текст = """"; // МетодОписание
	|	ПолеВвода4.Текст = """"; // МетодИмяРус
	|	ПолеВвода5.Текст = """"; // МетодИмяEn
	|	ПолеВыбора2.Текст = """"; // ВозвращаемоеЗначениеТип
	|	ПолеВвода8.Текст = """"; // ВозвращаемоеЗначениеОписание
	|	
	|	Для А = 0 По ПанельВкладок1.Вкладки.Количество - 1 Цикл
	|		Вкладка = ПанельВкладок1.Вкладки(А);
	|		Для А1 = 0 По Вкладка.ЭлементыУправления.Количество - 1 Цикл
	|			Элемент = Вкладка.ЭлементУправления(А1);
	|			Если ТипЗнч(Элемент) = Тип(""КлПолеВвода"") или ТипЗнч(Элемент) = Тип(""КлПолеВыбора"") Тогда
	|				Элемент.Текст = """";
	|			КонецЕсли;
	|		КонецЦикла;
	|	КонецЦикла;
	|	
	|	ЗаполнитьПолеВыбора22();
	|	ЗаполнитьПолеВыбора24();
	|	ЗаполнитьПолеВыбораТип();
	|	Флажок1.Помечен = Ложь;
	|КонецПроцедуры";
	ПодстрокаЗамены = 
	"Процедура НачальноеЗаполнениеФормы()
	|	ПолеВыбора22.Текст = """ + Текст_Класс + """; // Класс
	|	ПолеВвода3.Текст = """ + Текст_МетодОписание + """; // МетодОписание
	|	ПолеВвода4.Текст = """ + Текст_МетодИмяРус + """; // МетодИмяРус
	|	ПолеВвода5.Текст = """ + Текст_МетодИмяEn + """; // МетодИмяEn
	|	ПолеВыбора2.Текст = """ + Текст_ВозвращаемоеЗначениеТип + """; // ВозвращаемоеЗначениеТип
	|	ПолеВвода8.Текст = """ + Текст_ВозвращаемоеЗначениеОписание + """; // ВозвращаемоеЗначениеОписание
	|	ПолеВыбора23.Текст = """ + КлассРодителяРус + " " + КлассРодителяАнгл + """; // унаследовано от
	|	
	|	Для А = 0 По ПанельВкладок1.Вкладки.Количество - 1 Цикл
	|		Вкладка = ПанельВкладок1.Вкладки(А);
	|		Для А1 = 0 По Вкладка.ЭлементыУправления.Количество - 1 Цикл
	|			Элемент = Вкладка.ЭлементУправления(А1);
	|			Если ТипЗнч(Элемент) = Тип(""КлПолеВвода"") или ТипЗнч(Элемент) = Тип(""КлПолеВыбора"") Тогда
	|				Элемент.Текст = """";
	|			КонецЕсли;
	|		КонецЦикла;
	|	КонецЦикла;
	|	
	|	ЗаполнитьПолеВыбора22();
	|	ЗаполнитьПолеВыбора24();
	|	ЗаполнитьПолеВыбораТип();
	|	Флажок1.Помечен = Ложь;
	|	
	|	Ф.ПередатьУправление();
	|	// Приостановить(1000);
	|	Кн1_Нажатие();
	|КонецПроцедуры";
	Стр = СтрЗаменить(Стр, ПодстрокаПоиска, ПодстрокаЗамены);
	
	ПодстрокаПоиска = 
	"ОкноСообщений1 = Ф.ОкноСообщений();
	|	Если Флажок1.Помечен Тогда
	|		КопироватьФайл(ОткудаПереносим1, КудаПереносим1);
	|		Приостановить(500);
	|		КопироватьФайл(ОткудаПереносим2, КудаПереносим2);
	|		Приостановить(500);
	|		УдалитьФайлы(ВыходнойКаталог, ""*.html"");  
	|		Ф.Предупреждение(""Завершено "" + КлассИмяРус + ""."" + МетодИмяРус, 1, ""Завершено"");
	|	Иначе
	|		Ф.ОкноСообщений().Показать(""Завершено"", ""Завершено"");
	|	КонецЕсли;";
	ПодстрокаЗамены = 
	"//ОкноСообщений1 = Ф.ОкноСообщений();
	|//	Если Флажок1.Помечен Тогда
	|//		КопироватьФайл(ОткудаПереносим1, КудаПереносим1);
	|//		Приостановить(500);
	|//		КопироватьФайл(ОткудаПереносим2, КудаПереносим2);
	|//		Приостановить(500);
	|//		УдалитьФайлы(ВыходнойКаталог, ""*.html"");  
	|//		Ф.Предупреждение(""Завершено "" + КлассИмяРус + ""."" + МетодИмяРус, 1, ""Завершено"");
	|//	Иначе
	|//		Ф.ОкноСообщений().Показать(""Завершено"", ""Завершено"");
	|//	КонецЕсли;
	|
	|	// Приостановить(1000);
	|
	|	ЗавершитьРаботу(0);";
	Стр = СтрЗаменить(Стр, ПодстрокаПоиска, ПодстрокаЗамены);
	
	ТекстДок.УстановитьТекст(Стр);
	ТекстДок.Записать(КопияФайла);
	Приостановить(1000);
	// Теперь нужно запустить КопияФайла.
	Команда1("""C:\Program Files\OneScript\bin\oscript.exe""", КопияФайла);
	
	// Приостановить(1000);
	
	НовыйФайлМетода = ОбъединитьПути("C:\444\OneScriptGameForms\НовыеHtml", "OSGForms." + СтрКлассаEn + МетодАнгл + "Method.html");
	ТекстДокНовый = Новый ТекстовыйДокумент;
	ТекстДокНовый.Прочитать(НовыйФайлМетода);
	СтрНовый = ТекстДокНовый.ПолучитьТекст();
	Фрагмент = "";
	М = ИОС.СтрНайтиМежду(СтрНовый, "<h4 class=dtH4>Синтаксис</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	Если М.Количество() > 0 Тогда
		// Сообщить("Фрагмент = " + М[0]);
		Фрагмент = М[0];
	КонецЕсли;	
	ПодстрокаПоиска = Фрагмент;
	
	Фрагмент2 = "";
	М2 = ИОС.СтрНайтиМежду(СтрТекстДок, "<h4 class=dtH4>Синтаксис</h4>", "<h4 class=dtH4>Примечание</h4>", , );
	Если М2.Количество() > 0 Тогда
		// Сообщить("Фрагмент2 = " + М2[0]);
		Фрагмент2 = М2[0];
	КонецЕсли;	
	ПодстрокаЗамены = Фрагмент2;
	
	СтрНовый = СтрЗаменить(СтрНовый, ПодстрокаПоиска, ПодстрокаЗамены);
	ТекстДокНовый.УстановитьТекст(СтрНовый);
	ТекстДокНовый.Записать(НовыйФайлМетода);
	Приостановить(1000);
	
	// Теперь нужно переместить с заменой файлы из "C:\444\OneScriptGameForms\НовыеHtml" в 
	// "C:\444\OneScriptGameForms\docs\OSGForms".
	Файлы = НайтиФайлы("C:\444\OneScriptGameForms\НовыеHtml", "*.html", Ложь);
	Для А1 = 0 По Файлы.ВГраница() Цикл
		// Сообщить("" + Файлы[А1].Имя);
		Попытка
			УдалитьФайлы("C:\444\OneScriptGameForms\docs\OSGForms\" + Файлы[А1].Имя);
		Исключение
		КонецПопытки;
		Приостановить(1000);
		ПереместитьФайл(Файлы[А1].ПолноеИмя, ОбъединитьПути("C:\444\OneScriptGameForms\docs\OSGForms", Файлы[А1].Имя));
	КонецЦикла;

КонецПроцедуры//СоздатьУнаследованныйМетод

Процедура СоздатьНаследуемыеМетоды()
	СтрКлассаEn = ИОС.СтрНайтиМежду(СтрКласса, "(", ")", , )[0];
	ПутьФайлHTMLКласса = ОбъединитьПути(КаталогСправки, "OSGForms." + СтрКлассаEn + ".html");
	// Сообщить("ПутьФайлHTMLКласса = " + ПутьФайлHTMLКласса);
	
	// Строим цепочку наследования до самого верхнего родителя.
	СписокРодителей = ПостроитьСписокРодителей(ПутьФайлHTMLКласса);
	// Заполним список уже занесенных в справку методов наследника.
	// C:\444\OneScriptGameForms\docs\OSGForms\OSGForms.ButtonMethods.html
	ПутьФайлHTMLМетодов = ОбъединитьПути(КаталогСправки, "OSGForms." + СтрКлассаEn + "Methods.html");
	СписокМетодовНаследникаИзСправки = ПостроитьСписокМетодовИзСправки(ПутьФайлHTMLМетодов);
	Если СписокРодителей.Количество() > 0 Тогда
		// Перебираем родителей, получаем их методы, только те, которые не унаследованы.
		// Если в СписокМетодовНаследникаИзСправки не находим такого метода, то создаем его в справке.
		Для А = 0 По СписокРодителей.Количество() - 1 Цикл
			ПутьФайлHTMLМетодовРодителя = СписокРодителей.Получить(А).Значение;
			ПутьФайлHTMLМетодовРодителя = СтрЗаменить(ПутьФайлHTMLМетодовРодителя, ".html", "Methods.html");
			// Сообщить("ПутьФайлHTMLМетодовРодителя === " + ПутьФайлHTMLМетодовРодителя);
			ТекущийРодитель = СписокРодителей.Получить(А).Представление;
			// Сообщить("=== " + ТекущийРодитель + " ===");
			СписокМетодовРодителяИзСправки = ПостроитьСписокМетодовИзСправки(ПутьФайлHTMLМетодовРодителя);
			Для А1 = 0 По СписокМетодовРодителяИзСправки.Количество() - 1 Цикл
				Представление = СписокМетодовРодителяИзСправки.Получить(А1).Представление;
				Если Не СтрНайти(Представление, "(унаследовано от") > 0 Тогда
					МетодРодителя = СписокМетодовРодителяИзСправки.Получить(А1).Значение;
					// Сообщить("=== Значение = " + МетодРодителя);
					// Сообщить("=== Представление =" + СписокМетодовРодителяИзСправки.Получить(А1).Представление);
					// Проверим наличие метода в справке. Если не найдем, то создадим в справке.
					Если СписокМетодовНаследникаИзСправки.НайтиПоЗначению(МетодРодителя) = Неопределено Тогда
						// Создадим в справке.
						Сообщить("=== Создаем метод " + МетодРодителя + " Унаследовано от " + ТекущийРодитель);
						// ПутьФайлHTMLМетодовРодителя === C:\444\OneScriptGameForms\docs\OSGForms\OSGForms.GObjectMethods.html
						
						МетодИмяEn = ИОС.СтрНайтиМежду(МетодРодителя, "(", ")", , )[0];
						ПутьДоМетодаРодителя = СтрЗаменить(ПутьФайлHTMLМетодовРодителя, "Methods.html", "." + МетодИмяEn + "Method.html");
						Наследник = СтрЗаменить(СтрКласса, " Класс", "");
						Наследник = СтрЗаменить(Наследник, "(", "");
						Наследник = СтрЗаменить(Наследник, ")", "");
						СоздатьУнаследованныйМетод(ПутьДоМетодаРодителя, МетодРодителя, ТекущийРодитель, Наследник, СтрКлассаEn);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	// // // Ф.ОкноСообщений().Показать("Завершено", "Завершено");
КонецПроцедуры//СоздатьНаследуемыеМетоды

Функция Команда1(ИмяФайла, Аргументы)
	Процесс1 = СоздатьПроцесс(ИмяФайла + " " + Аргументы,,,);
	Процесс1.Запустить();
	Ф.ПередатьУправление();
	Процесс1.ОжидатьЗавершения();
КонецФункции//Команда1

Процедура Флажок1_ПометкаИзменена() Экспорт
	Если Флажок1.Помечен = Истина Тогда
		ПолеВыбора4.Текст = "";
		ПолеВыбора4.Доступность = Ложь;
	Иначе
		ПолеВыбора4.Доступность = Истина;
		Кнопка1.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

